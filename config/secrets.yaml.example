# Gitignored — copy to Config/secrets.yaml and fill in your API key
#
# DeepSeek (recommended):
#   llm:
#     provider: deepseek
#     model: deepseek-chat
#     base_url: https://api.deepseek.com/v1
#     api_key: "sk-..."

llm:
  provider: deepseek
  model: deepseek-chat
  base_url: https://api.deepseek.com/v1
  api_key: ""

providers:
  deepseek:
    api_key: ""
